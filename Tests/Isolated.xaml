                <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim excelApp As Microsoft.Office.Interop.Excel.Application = Nothing&#xD;&#xA;Dim excelWorkbook As Microsoft.Office.Interop.Excel.Workbook = Nothing&#xD;&#xA; &#xD;&#xA;Try&#xD;&#xA;    ' 1. DESBLOQUEO AUTOMÁTICO DE SEGURIDAD NATIVO (.NET)&#xD;&#xA;    If System.IO.File.Exists(in_WorkbookPath) Then&#xD;&#xA;        Using proc As New System.Diagnostics.Process()&#xD;&#xA;            proc.StartInfo.FileName = &quot;powershell.exe&quot;&#xD;&#xA;            proc.StartInfo.Arguments = &quot;-WindowStyle Hidden -Command &quot;&quot;Unblock-File -Path '&quot; &amp; in_WorkbookPath &amp; &quot;'&quot;&quot;&quot;&#xD;&#xA;            proc.StartInfo.CreateNoWindow = True&#xD;&#xA;            proc.StartInfo.UseShellExecute = False&#xD;&#xA;            proc.Start()&#xD;&#xA;            proc.WaitForExit()&#xD;&#xA;        End Using&#xD;&#xA;    End If&#xD;&#xA; &#xD;&#xA;    ' 2. INICIALIZACIÓN DE EXCEL&#xD;&#xA;    excelApp = New Microsoft.Office.Interop.Excel.Application()&#xD;&#xA;    excelApp.Visible = False &#xD;&#xA;    excelApp.DisplayAlerts = False&#xD;&#xA; &#xD;&#xA;    ' 3. CONFIGURACIÓN ANTI-COLAPSO (Evita el timeout de 5 segundos)&#xD;&#xA;    ' Cambiar a cálculo manual para que no intente procesar fórmulas/tablas pesadas al abrir&#xD;&#xA;    excelApp.Calculation = Microsoft.Office.Interop.Excel.XlCalculation.xlCalculationManual&#xD;&#xA; &#xD;&#xA;    ' 4. APERTURA DEL LIBRO&#xD;&#xA;    ' UpdateLinks:=0 evita que Excel intente actualizar conexiones externas pesadas al abrir&#xD;&#xA;    excelWorkbook = excelApp.Workbooks.Open(in_WorkbookPath, UpdateLinks:=0)&#xD;&#xA;    ' 5. RESTAURACIÓN DEL CÁLCULO Y EJECUCIÓN&#xD;&#xA;    ' Volvemos a activar el cálculo automático justo antes de correr la macro por si esta lo requiere&#xD;&#xA;    excelApp.Calculation = Microsoft.Office.Interop.Excel.XlCalculation.xlCalculationAutomatic&#xD;&#xA; &#xD;&#xA;    ' Ejecutar la macro&#xD;&#xA;    excelApp.Run(in_MacroName)&#xD;&#xA;    ' 6. GUARDAR Y CERRAR&#xD;&#xA;    excelWorkbook.Save()&#xD;&#xA;    excelWorkbook.Close(True)&#xD;&#xA;    ' Inicializar salida de error vacía si todo fue exitoso&#xD;&#xA;    outException = String.Empty&#xD;&#xA;Catch ex As Exception&#xD;&#xA;    ' Asignamos el mensaje a la variable de UiPath ANTES de lanzar el error&#xD;&#xA;    outException = ex.Message&#xD;&#xA;    ' Relanzamos la excepción controlada para UiPath&#xD;&#xA;    Throw New Exception(&quot;Error controlado en ejecución de macro: &quot; &amp; ex.Message, ex)&#xD;&#xA;Finally&#xD;&#xA;    ' 7. LIMPIEZA ABSOLUTA DE PROCESOS COM (Evita procesos EXCEL.EXE fantasmas)&#xD;&#xA;    If excelWorkbook IsNot Nothing Then&#xD;&#xA;        System.Runtime.InteropServices.Marshal.FinalReleaseComObject(excelWorkbook)&#xD;&#xA;        excelWorkbook = Nothing&#xD;&#xA;    End If&#xD;&#xA;    If excelApp IsNot Nothing Then&#xD;&#xA;        ' Asegurar que el cálculo regrese a automático global antes de cerrar&#xD;&#xA;        Try&#xD;&#xA;            excelApp.Calculation = Microsoft.Office.Interop.Excel.XlCalculation.xlCalculationAutomatic&#xD;&#xA;        Catch&#xD;&#xA;            ' Ignorar si la app ya falló&#xD;&#xA;        End Try&#xD;&#xA;        excelApp.Quit()&#xD;&#xA;        System.Runtime.InteropServices.Marshal.FinalReleaseComObject(excelApp)&#xD;&#xA;        excelApp = Nothing&#xD;&#xA;    End If&#xD;&#xA;    ' Forzar la liberación inmediata de memoria RAM&#xD;&#xA;    GC.Collect()&#xD;&#xA;    GC.WaitForPendingFinalizers()&#xD;&#xA;End Try" DisplayName="Execute Excel macro via VB.NET code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_6">
