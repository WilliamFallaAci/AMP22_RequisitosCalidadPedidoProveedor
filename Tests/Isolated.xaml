    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Usamos la codificación ISO-8859-1 que es nativa y compatible con los reportes ANSI de SAP&#xA;Dim enc As System.Text.Encoding = System.Text.Encoding.GetEncoding(&quot;ISO-8859-1&quot;)&#xA;&#xA;' Leer todas las líneas usando la codificación correcta&#xA;Dim lineas As String() = File.ReadAllLines(in_FilePath, enc)&#xA;&#xA;Dim dt As New System.Data.DataTable()&#xA;Dim encabezadoDetectado As Boolean = False&#xA;&#xA;For Each linea As String In lineas&#xA;    Dim lineaLimpia As String = linea.Trim()&#xA;    &#xA;    ' 1. Ignorar líneas vacías, divisorias (---) o metadatos de SAP&#xA;    If String.IsNullOrEmpty(lineaLimpia) OrElse lineaLimpia.StartsWith(&quot;-&quot;) OrElse lineaLimpia.Contains(&quot;Salida&quot;) Then&#xA;        Continue For&#xA;    End If&#xA;    &#xA;    ' 2. Verificar que la línea realmente contenga el caracter pipe '|'&#xA;    If Not lineaLimpia.Contains(&quot;|&quot;) Then&#xA;        Continue For&#xA;    End If&#xA;&#xA;    ' 3. Separar por pipe '|'&#xA;    Dim partes As String() = lineaLimpia.Split(New Char() {&quot;|&quot;c})&#xA;    &#xA;    ' Extraer solo las celdas internas (omitiendo el primer y último elemento vacío por los pipes de los extremos)&#xA;    Dim celdasReales As New List(Of String)()&#xA;    For i As Integer = 1 To partes.Length - 2&#xA;        celdasReales.Add(partes(i).Trim())&#xA;    Next&#xA;&#xA;    ' 4. Procesar el Encabezado de la tabla&#xA;    If Not encabezadoDetectado Then&#xA;        ' Comprobamos si es la fila de títulos buscando la columna Ce.&#xA;        If celdasReales.Count &gt; 0 AndAlso celdasReales(0).StartsWith(&quot;Ce.&quot;) Then&#xA;            For Each columna As String In celdasReales&#xA;                Dim nombreCol As String = columna&#xA;                Dim contador As Integer = 1&#xA;                While dt.Columns.Contains(nombreCol)&#xA;                    nombreCol = columna &amp; &quot;_&quot; &amp; contador&#xA;                    contador += 1&#xA;                End While&#xA;                dt.Columns.Add(nombreCol)&#xA;            Next&#xA;            encabezadoDetectado = True&#xA;        End If&#xA;    Else&#xA;        ' 5. Procesar las Filas de datos&#xA;        If celdasReales.Count = dt.Columns.Count Then&#xA;            dt.Rows.Add(celdasReales.ToArray())&#xA;        End If&#xA;    End If&#xA;Next&#xA;&#xA;out_Dt = dt" DisplayName="Execute VB.Net code to read file and populate data table" sap:VirtualizedContainerService.HintSize="536,197" sap2010:WorkflowViewState.IdRef="InvokeCode_5">
